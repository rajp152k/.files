theme = modern-dark-high-contrast
font-family = "Iosevka"

# Keep the neutral near-black foundation opaque and preserve readable
# application colours without artificially flattening the palette.
background-opacity = 1.0
minimum-contrast = 3.0

# Cursor
cursor-style = block
cursor-style-blink = true

# Send Option (incl. remapped Windows key) as Esc+/Meta instead of
# composing characters (Opt+Z was inserting Ω). Needed for omp Alt+ chords.
# Use "left" or "right" instead of "true" to keep one side for symbols.
macos-option-as-alt = true
