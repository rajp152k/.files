#kanata mouseless
alias kml="bash ~/.load/kanata.sh"

#watch
alias wn1="watch -n 1"

#nvim
alias nvim=$HOME/source/tools/nvim/nvim-macos-arm64/bin/nvim
alias vi='nvim'

alias spi='cd $HOME/source/scratch/pi && pi'

alias lt='ls -lthU'

alias cid='caffeinate -id'

#blog
alias write='cd $HOME/source/blog/yetanotherraj && ./write.sh'
alias publish='cd $HOME/source/blog/yetanotherraj && ./publish.sh'

# rust
alias cr='cargo run --'

#git 
alias gcls='git clone --depth 1 --single-branch --filter=blob:none'
alias nvd='git difftool -y -t nvimdiff'

#C
alias c17='clang --std=c17'
alias c23='clang --std=c23'

#autolith
_a() { command autolith --fullscreen "$@" }

a()   { _a "$@" }
al()  { cd ~/source/laboratory && _a "$@" }
als() { _a localgroup status "$@" }
alp() { _a localgroup pause "$@" }
ala() { _a localgroup attach "$@" }
ald() { _a localgroup detach "$@" }
alk() { _a localgroup kill "$@" }
alt() { _a localgroup tell "$@" }
ae()  { cd ~/.config/autolith && _a "$@" }
