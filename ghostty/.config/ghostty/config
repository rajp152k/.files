theme = solarized-light-high-contrast
font-family = "Iosevka"

# An opaque background prevents the desktop from washing out text at lower
# display brightness. Enforce a useful floor for application-defined colours.
background-opacity = 1.0
minimum-contrast = 3.0

# Cursor
cursor-style = block
cursor-style-blink = true

# Send Option (incl. remapped Windows key) as Esc+/Meta instead of
# composing characters (Opt+Z was inserting Ω). Needed for omp Alt+ chords.
# Use "left" or "right" instead of "true" to keep one side for symbols.
macos-option-as-alt = true
