# High-contrast green on black.
background = #000000
foreground = #00ff00
font-family = "Fira Mono"
font-size = 12
background-opacity = 1.0
minimum-contrast = 1.0

# Monochrome ANSI palette.
palette = 0=#000000
palette = 1=#00ff00
palette = 2=#00ff00
palette = 3=#7fff00
palette = 4=#00ff00
palette = 5=#39ff14
palette = 6=#00ff00
palette = 7=#ccffcc
palette = 8=#006600
palette = 9=#39ff14
palette = 10=#39ff14
palette = 11=#b6ff00
palette = 12=#39ff14
palette = 13=#7fff00
palette = 14=#b6ff00
palette = 15=#ffffff

# Fixed block cursor and green selection.
cursor-style = block
cursor-style-blink = false
cursor-color = #ffffff
cursor-text = #000000
selection-background = #00b300
selection-foreground = #000000

# Send Option (incl. remapped Windows key) as Esc+/Meta instead of
# composing characters (Opt+Z was inserting Ω). Needed for omp Alt+ chords.
# Use "left" or "right" instead of "true" to keep one side for symbols.
macos-option-as-alt = true
