# Bit-Mage: green text, violet selection, and distinct ANSI colors.
theme = bit-mage
font-family = "Fira Mono"
font-size = 12
background-opacity = 1.0
minimum-contrast = 1.0

# A static, square #00ff00 frame around the terminal viewport.
custom-shader = shaders/green-border.glsl
custom-shader-animation = false

# Fixed block cursor; the theme supplies its colors and violet selection.
cursor-style = block
cursor-style-blink = false

# Send Option (incl. remapped Windows key) as Esc+/Meta instead of
# composing characters (Opt+Z was inserting Ω). Needed for omp Alt+ chords.
# Use "left" or "right" instead of "true" to keep one side for symbols.
macos-option-as-alt = true
